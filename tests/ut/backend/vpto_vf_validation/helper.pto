// Validation fixture: an externally callable device function owns only the VF.
// The caller owns UB allocation, GM transfers, and inter-pipeline synchronization.
module attributes {pto.target_arch = "a5", pto.backend = "vpto",
                   pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func public @run_vf(%lhs: !pto.ptr<f32, ub>,
                           %rhs: !pto.ptr<f32, ub>,
                           %out: !pto.ptr<f32, ub>, %n: i32)
      attributes {pto.visibility = "external"} {
    %c0 = arith.constant 0 : index
    %c64 = arith.constant 64 : index
    %end = arith.index_cast %n : i32 to index
    pto.vecscope {
      %remaining = scf.for %offset = %c0 to %end step %c64
          iter_args(%remaining = %n) -> (i32) {
        %mask, %next = pto.plt_b32 %remaining
            : i32 -> !pto.mask<b32>, i32
        %a = pto.vlds %lhs[%offset]
            : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
        %b = pto.vlds %rhs[%offset]
            : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
        %sum = pto.vadd %a, %b, %mask
            : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32>
              -> !pto.vreg<64xf32>
        pto.vsts %sum, %out[%offset], %mask
            : !pto.vreg<64xf32>, !pto.ptr<f32, ub>, !pto.mask<b32>
        scf.yield %next : i32
      }
    }
    return
  }
}
